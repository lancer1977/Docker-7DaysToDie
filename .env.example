# Docker-7DaysToDie local/runtime environment
#
# Copy to .env for local compose or runtime experiments. Do not commit .env.
# The defaults mirror Dockerfile/docs defaults and keep optional mods disabled.

# Image/build defaults
APP_BUILD_CONTEXT=.
APP_DOCKERFILE=Dockerfile
APP_LOCAL_IMAGE=vinanrra/7dtd-server:local
APP_CONTAINER_NAME=7dtd-local
APP_RESTART=unless-stopped

# Container runtime defaults
START_MODE=1
VERSION=stable
TimeZone=Europe/Madrid
PUID=1000
PGID=1000
CHANGE_CONFIG_DIR_OWNERSHIP=YES

# LinuxGSM automation
BACKUP=no
MONITOR=no
TEST_ALERT=no

# Mod update gate
UPDATE_MODS=no

# Optional mods
ALLOC_FIXES=no
ALLOC_FIXES_UPDATE=no
UNDEAD_LEGACY=no
UNDEAD_LEGACY_VERSION=stable
UNDEAD_LEGACY_UPDATE=no
ENZOMBIES=no
ENZOMBIES_ADDON_SNUFKIN=no
ENZOMBIES_ADDON_ROBELOTO=no
ENZOMBIES_ADDON_NONUDES=no
ENZOMBIES_UPDATE=no
CPM=no
CPM_UPDATE=no
BEPINEX=no
BEPINEX_UPDATE=no
